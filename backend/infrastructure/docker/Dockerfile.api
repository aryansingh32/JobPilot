FROM node:20-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json* tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/api-service/package.json packages/api-service/
COPY packages/execution-service/package.json packages/execution-service/
COPY packages/crawler-service/package.json packages/crawler-service/
COPY packages/ai-service/package.json packages/ai-service/
COPY packages/scheduler-service/package.json packages/scheduler-service/
RUN npm ci

COPY packages/ packages/
COPY scripts/ scripts/
COPY workflows/ workflows/

# The API process hosts the admin workflow recorder and dry-run routes
# (admin-routes.ts imports execution-service/recorder.ts and
# dry-run-service.ts directly), both of which launch a real Playwright
# browser via the same browser pool the worker uses — so the api image
# needs the browser binary too, not just the worker image.
RUN npx playwright install --with-deps chromium

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

CMD ["npm", "run", "dev:api"]
