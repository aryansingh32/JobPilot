{
  "id": "job-apply-zoho",
  "siteId": "ats-zoho",
  "category": "jobs",
  "name": "Zoho Recruit — Apply",
  "trigger": "apply zoho",
  "triggerPhrases": [
    "apply on zoho"
  ],
  "portalType": "jobs",
  "entryUrl": "https://www.zohorecruit.in/",
  "pageUrlPatterns": [
    "\\.zohorecruit\\.[a-z.]+/jobs/Careers/"
  ],
  "requiredInputs": [],
  "requiredFiles": [
    "resume"
  ],
  "instructions": "Opens the job, declines non-essential cookies, opens the form (\"I'm interested\" / Apply), fills it from the profile and remembered answers, asks for any required answer it doesn't know, pauses for review, then submits (an image captcha is shown to the user).",
  "starterActionPlan": [
    {
      "id": "open",
      "order": 1,
      "action": "navigate",
      "value": "{{job:applyUrl}}",
      "timeout": 45000,
      "retries": 1,
      "description": "Open the application form"
    },
    {
      "id": "fill",
      "order": 2,
      "action": "autofillForm",
      "timeout": 120000,
      "retries": 0,
      "description": "Fill the form from your profile",
      "metadata": {
        "openApplyButton": true
      }
    },
    {
      "id": "review",
      "order": 3,
      "action": "reviewForm",
      "retries": 0,
      "description": "Wait for your approval"
    },
    {
      "id": "submit",
      "order": 4,
      "action": "submitForm",
      "timeout": 45000,
      "retries": 0,
      "description": "Submit the application"
    }
  ],
  "errorRecoveryPlan": [],
  "isActive": true,
  "version": 1,
  "metadata": {
    "kind": "job-apply",
    "atsType": "zoho",
    "source": "file"
  }
}
