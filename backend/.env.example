# Core runtime
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# REQUIRED — generate a real random value, e.g. `openssl rand -hex 32`. There is
# no working fallback: the server refuses to start without this.
API_KEY=
LOG_LEVEL=debug
RATE_LIMIT=100
CORS_ORIGIN=http://localhost:5173,http://localhost:3001,http://localhost:4173,http://localhost:8080

# ── Auth ─────────────────────────────────────────────────────
# REQUIRED — signs/verifies end-user and admin session cookies. Generate with
# `openssl rand -hex 32`. Rotating this logs everyone out.
SESSION_JWT_SECRET=
# REQUIRED — used by crypto-service.ts to envelope-encrypt stored secrets.
APP_SECRET_KEY=
# Admin panel login (username/password) — set both to seed the first admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: a static key for scripted/CI access to /admin/* routes, in addition
# to (or instead of) the username/password login above.
ADMIN_API_KEY=

# Google Sign-In — create an OAuth 2.0 Client ID (Web application) in Google
# Cloud Console; only the client ID is needed server-side (ID-token verification
# uses Google's public keys, no client secret required).
GOOGLE_CLIENT_ID=

# Email OTP — SMTP provider. Leave unset in dev to log codes to the console
# instead of sending real email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@jobpilot.app

# Mobile OTP — Twilio. Leave unset in dev to log codes to the console instead
# of sending a real SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=automation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PUBLIC_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PUBLIC_PORT=6379

# API public port for docker compose
API_PUBLIC_PORT=3000

# LLMs - OpenRouter defaults
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ENABLE_REASONING=true
CHAT_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
AI_PLANNER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Selector resolution and error recovery are single-shot classification /
# short structured-JSON tasks, not multi-step reasoning — default to the
# non-reasoning sibling model (same free tier) instead of paying for a
# reasoning trace nobody uses. Leave unset to use this default automatically.
AI_SELECTOR_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
AI_RECOVERY_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Browser / execution
MIN_BROWSERS=1
MAX_BROWSERS=3
MAX_CONTEXTS_PER_BROWSER=4
USER_FILE_STORAGE_ROOT=/data/user-files

# Workflow system
WORKFLOW_AUTOLOAD=true

# Optional integrations
CAPTCHA_WEBHOOK_URL=
WHISPER_API_URL=

# Legacy single-provider premium captcha solver (2Captcha-compatible
# in.php/res.php API) — kept for backward compatibility. Prefer the
# provider-specific keys below for new setups; CAPTCHA_SOLVER_API_KEY is
# read as a fallback for CAPTCHA_PROVIDER_2CAPTCHA_KEY if that's unset.
CAPTCHA_SOLVER_API_KEY=
CAPTCHA_SOLVER_BASE_URL=https://2captcha.com
MAX_CAPTCHA_SPEND=5.0

# CAPTCHA subsystem — provider abstraction (backend/packages/execution-service/captcha/).
# Set whichever of these keys you actually have accounts for; unset ones are
# simply skipped by the provider registry. CAPTCHA_PROVIDER_PRIORITY controls
# selection order when more than one is configured for the same challenge type.
CAPTCHA_PROVIDER_2CAPTCHA_KEY=
CAPTCHA_PROVIDER_ANTICAPTCHA_KEY=
CAPTCHA_PROVIDER_CAPSOLVER_KEY=
CAPTCHA_PROVIDER_PRIORITY=2captcha,anti-captcha,capsolver

# Never loops more than this many total attempts (free in-browser tier +
# paid provider tier combined) before falling back to human-in-the-loop.
CAPTCHA_MAX_AUTO_ATTEMPTS=2

# Plan gating — free-plan users are always routed to human-in-the-loop
# (limit 0 = no automated provider spend at all). Premium users get a real
# monthly call budget AND a hard spend cap; whichever is hit first wins.
FREE_PLAN_AUTO_SOLVE_MONTHLY_LIMIT=0
PREMIUM_PLAN_AUTO_SOLVE_MONTHLY_LIMIT=500
PREMIUM_PLAN_MONTHLY_SPEND_CAP_USD=5.0

# Learning flywheel — a cached AI-generated flow with (successes - failures)
# at or above this threshold is auto-promoted into a draft site_workflows
# row (never auto-published; an admin still reviews it).
WORKFLOW_PROMOTION_THRESHOLD=3

# Optional observability ports
PROMETHEUS_PUBLIC_PORT=9090
GRAFANA_PUBLIC_PORT=3001
GRAFANA_PASSWORD=admin
