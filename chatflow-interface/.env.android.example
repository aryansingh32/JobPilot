# Android app build (npm run build:android / android:apk). Copy to .env.android.
# The app runs from bundled files at https://localhost, so these must be full
# URLs the phone can reach — not localhost.

# Your public API (https). For the emulator against a local backend use
# http://10.0.2.2:3000 and build with `npm run android:dev` (allows plain http).
VITE_API_BASE_URL=https://api.example.com

# Must match backend API_KEY.
VITE_API_KEY=

# Push notifications: set to true only after adding android/app/google-services.json
# from your Firebase project (the app crashes registering for push without it).
# The backend needs FCM_SERVICE_ACCOUNT (or FCM_SERVICE_ACCOUNT_FILE) to send.
VITE_PUSH_ENABLED=false

# Google sign-in uses Google's web button, which Google blocks inside app web
# views — leave empty for the app (email / mobile OTP sign-in work).
VITE_GOOGLE_CLIENT_ID=
