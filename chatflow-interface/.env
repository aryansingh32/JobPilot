# Backend API URL (Proxied via Vite to localhost:3000)
VITE_API_BASE_URL=/api

# API Key for backend authentication — must match backend API_KEY. Set a real
# value locally (see backend/.env.example); there is no working default.
VITE_API_KEY=

# Google OAuth Web Client ID — set to enable the Google Sign-In button in dev.
VITE_GOOGLE_CLIENT_ID=
