# Backend API URL
VITE_API_BASE_URL=http://localhost:3000

# API Key for backend authentication (must match backend API_KEY). This is a
# client-identity key, not a per-user secret — real authorization comes from
# the session cookie issued at /auth/*, not this value.
VITE_API_KEY=

# Google OAuth Web Client ID (from Google Cloud Console), used by the Google
# Sign-In button. Safe to expose client-side — it identifies the app, not a
# secret (ID-token verification happens server-side against Google's keys).
VITE_GOOGLE_CLIENT_ID=

# There is no VITE_USER_ID or VITE_ADMIN_KEY anymore. End-user identity comes
# from the session cookie issued by /auth/google, /auth/email/verify, or
# /auth/mobile/verify. The admin panel authenticates via a separate session
# cookie issued by POST /auth/admin/login — no admin key is ever held in the
# browser bundle.
